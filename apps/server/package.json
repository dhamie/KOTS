{
  "name": "@kots/server",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "vite build",
    "dev:api": "vite build && node dist/api.cjs",
    "dev:worker": "vite build && node dist/worker.cjs",
    "start:api": "node dist/api.cjs",
    "start:worker": "node dist/worker.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:seed": "vite build && node dist/seed.cjs",
    "mod:grant": "vite build && node dist/mod.cjs grant",
    "mod:revoke": "vite build && node dist/mod.cjs revoke",
    "event:trigger": "vite build && node dist/event.cjs",
    "admin": "vite build && node dist/admin.cjs"
  },
  "dependencies": {
    "@kots/content": "*",
    "@kots/rules": "*",
    "@kots/shared": "*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.3"
  }
}
