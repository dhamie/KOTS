# Environment variables the server reads. The values below are the built-in defaults;
# export them in your shell only if you need something different.
DATABASE_URL=postgres://kots:kots@localhost:5434/kots
TEST_DATABASE_URL=postgres://kots:kots@localhost:5434/kots_test
API_PORT=4100
# Origins allowed to make state-changing requests (CSRF defence), comma-separated.
ALLOWED_ORIGINS=http://localhost:5180
