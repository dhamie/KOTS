# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored: never commit it.

# The game's domain, pointed at this server (an A record). Caddy gets the HTTPS certificate for it.
SITE_ADDRESS=kots.example
# The address players' browsers use, with https://. Several can be given, comma-separated.
ALLOWED_ORIGINS=https://kots.example

# Postgres password. Use letters and digits only, since it goes into a URL: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Optional: the image tag to build and run (e.g. a git tag), for rolling back. Defaults to latest.
# KOTS_VERSION=v0.10.0
# Optional: host ports, for a local check on a machine where 80/443 are taken.
# HTTP_PORT=80
# HTTPS_PORT=443
